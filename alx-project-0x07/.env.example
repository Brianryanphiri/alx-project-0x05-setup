# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# OPENAI_API_KEY=your_openai_api_key_here

# App Configuration
NEXT_PUBLIC_APP_NAME="AI Image Generator"
NEXT_PUBLIC_APP_DESCRIPTION="Generate amazing AI-powered images"
NEXT_PUBLIC_DEFAULT_IMAGE_SIZE="1024x1024"

# Feature Flags
NEXT_PUBLIC_ENABLE_IMAGE_SAVING=true
NEXT_PUBLIC_ENABLE_SHARING=true

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=10
NEXT_PUBLIC_RATE_LIMIT_INTERVAL=3600  # 1 hour in seconds

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=your_ga_tracking_id
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
